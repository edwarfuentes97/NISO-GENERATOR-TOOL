{
  "name": "niso-generator-tool",
  "version": "2.0.0",
  "description": "Generador de piezas gráficas NISO (PNG y PDF)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "preparar-fotos": "./scripts/preparar-fotos.sh",
    
    "fotos": "./scripts/preparar-fotos.sh",
    "reel": "./scripts/preparar-fotos.sh && node src/render-reel.js",
    "posts": "node src/render-posts.js",
    "stories": "node src/render-stories.js",
    "destacadas": "node src/render-destacadas.js",
    "flyers": "node src/render-flyers.js",
    "menu": "node src/render-menu-carta.js",
    "carta-precios": "node src/render-carta-precios.js",
    "catalogo": "node src/render-catalogo.js",
    "promos": "node src/render-promocionales.js",
